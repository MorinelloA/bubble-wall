{
  "name": "bubble-wall",
  "private": true,
  "version": "1.0.0",
  "description": "A full-screen sensory bubble wall for iPad.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "layers": "depcruise src --config .dependency-cruiser.cjs",
    "deadcode": "knip --production && knip",
    "dupes": "jscpd",
    "e2e": "playwright test",
    "audit:deps": "npm audit --json | node scripts/audit-gate.mjs high",
    "licenses": "npm query \"*\" | node scripts/licenses.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run layers && npm run deadcode && npm run dupes",
    "check:full": "npm run check && npm run build && npm run e2e && npm run audit:deps && npm run licenses",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "@vitest/eslint-plugin": "1.6.28",
    "dependency-cruiser": "18.9.0",
    "eslint": "10.15.0",
    "eslint-plugin-security": "4.2.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "happy-dom": "21.0.4",
    "jscpd": "5.4.3",
    "knip": "6.48.0",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
